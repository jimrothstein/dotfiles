{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": { "*": "ask", "~/dotfiles/**": "allow" }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/jim/code/mcp_project"
      ]
    },
    "15-min-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/jim/code/mcp_project/15-min-mcp",
        "15-min-mcp"
      ],
      "cwd": "/home/jim/code/mcp_project/15-min-mcp"
    },
    "notes": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/jim/code/mcp_project/notes-mcp",
        "python",
        "server.py"
      ],
      "cwd": "/home/jim/code/mcp_project/notes-mcp"
    },
    "gmail-organizer": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/jim/code/python_project/gmail-mcp/.venv/bin/python",
        "/home/jim/code/python_project/gmail-mcp/server.py"
      ],
      "cwd": "/home/jim/code/python_project/gmail-mcp",
      "timeout": 15000
    },
    "youtube": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/jim/code/mcp_project/pauling-mcp/.venv/bin/youtube-studio-mcp"
      ],
      "cwd": "/home/jim/code/mcp_project/pauling-mcp",
      "environment": {
        "YOUTUBE_MCP_CLIENT_SECRET": "/home/jim/code/mcp_project/pauling-mcp/.client_secret.json",
        "YOUTUBE_MCP_CONFIG_DIR": "/home/jim/code/mcp_project/pauling-mcp/.config/youtube-mcp"
      }
    }
  }
}