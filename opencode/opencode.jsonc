{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": { "*": "ask", "~/dotfiles/**": "allow" }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/jim/code/mcp_project"
      ]
    },
    "notes": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "/home/jim/code/mcp_project/notes-mcp",
        "python",
        "server.py"
      ],
      "cwd": "/home/jim/code/mcp_project/notes-mcp"
    },
    "gmail-organizer": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/jim/code/python_project/gmail-mcp/.venv/bin/python",
        "/home/jim/code/python_project/gmail-mcp/server.py"
      ],
      "cwd": "/home/jim/code/python_project/gmail-mcp",
      "timeout": 15000
    }
  }
}